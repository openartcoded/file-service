            ]
          },
          "correlationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "creationDate": {
            "type": "string",
            "format": "date-time"
          },
          "extension": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "originalFilename": {
            "type": "string"
          },
          "publicResource": {
            "type": "boolean"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "thumb": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "thumbnailId": {
            "type": [
              "string",
              "null"
            ]
          },
          "updatedDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
