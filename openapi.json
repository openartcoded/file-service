{
  "openapi": "3.1.0",
  "info": {
    "title": "kofte-rs",
    "description": "Köfte Api V1",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/template": {
      "post": {
        "tags": [
          "template::routes"
        ],
        "operationId": "upsert",
        "parameters": [
          {
            "name": "_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "title",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "description",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "templateType",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TemplateType"
            }
          },
          {
            "name": "templateContext",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Context"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file_bytes"
                ],
                "properties": {
                  "file_bytes": {
                    "type": "string",
                    "format": "binary",
                    "contentMediaType": "application/octet-stream"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Upsert a template"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
