  "components": {
    "schemas": {
      "Context": {
        "type": "string",
        "enum": [
          "INVOICE"
        ]
      },
      "RenderRequest": {
        "type": "object",
        "required": [
          "templateId",
          "context",
          "fileName",
          "templateContext"
        ],
        "properties": {
          "context": {},
          "fileName": {
            "type": "string"
          },
          "templateContext": {
            "$ref": "#/components/schemas/Context"
          },
          "templateId": {
            "type": "string"
          }
        }
      },
      "TemplateType": {
        "type": "string",
        "enum": [
          "HTML"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
